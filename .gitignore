# .gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
*.env
.vscode/

# Jupyter Notebook
.ipynb_checkpoints

# IDEs
.idea/
.project
.classpath
.settings/

# OS generated files
.DS_Store
.Trashes
ehthumbs.db
Thumbs.db

# Logs and Output
*.log
logs/
output/

# Cloud Function temporary files
/tmp/*

# Environment variables
.env

# ✅ src/bin 폴더와 ffmpeg, ffprobe 파일은 포함시킴
!src/bin/
!src/bin/ffmpeg
!src/bin/ffprobe
bin/
src/bin/
*.exe
*.out
