{
  "name": "GCP YouTube Automation",
  "build": {
    "dockerfile": "../src/Dockerfile",
    "context": "../src"
  },
  "remoteUser": "root",
  "postCreateCommand": "pip install -r src/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "GoogleCloudTools.cloudcode"
      ]
    }
  },
  // "features": { // 이 부분을 완전히 삭제하거나 주석 처리합니다.
  //   "ghcr.io/devcontainers/features/gcloud-cli:1": {}
  // },
  "forwardPorts": [8080]
}
