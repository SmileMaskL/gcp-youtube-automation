{
  "name": "Python 3.11 with GCP Tools",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/google-cloud-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "false",
      "installOhMyZsh": "false",
      "upgradePackages": "true"
    },
    // --- 다음 두 줄을 추가 또는 확인 ---
    // Docker in Docker (컨테이너 내에서 Docker 명령 사용) 기능 추가
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },
  // --- postCreateCommand를 수정 또는 추가 ---
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y jq && pip install --no-cache-dir -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "GoogleCloudTools.cloudcode"
      ]
    }
  }
}
