{
  "name": "GCP YouTube Automation",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "root",
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "GoogleCloudTools.cloudcode"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/gcloud-cli:1": {}
  },
  "forwardPorts": [8080]
}
