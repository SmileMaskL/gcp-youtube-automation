{
  "name": "Python 3.11 with GCP Tools",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/google-cloud-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "false",
      "installOhMyZsh": "false",
      "upgradePackages": "true"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    },
    // --- jq를 설치하는 새로운 Feature 추가 (더 안정적) ---
    "ghcr.io/devcontainers/features/apt-get-install:1": {
      "packages": "jq"
    }
  },
  // --- postCreateCommand는 Python 종속성 설치만 담당하도록 간소화 ---
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "GoogleCloudTools.cloudcode"
      ]
    }
  }
}
